{
  "name": "sidlak",
  "version": "0.2.0",
  "description": "Sidlak - live screen presenter for programs and pageants",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "electron": "^45.3.1"
  },
  "build": {
    "appId": "com.sidlak.app",
    "productName": "Sidlak",
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{legacy,web,types,iccs}/**",
      "!node_modules/pdfjs-dist/build/*.map",
      "!node_modules/pdfjs-dist/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/build/pdf.renderer*"
    ]
  }
}
